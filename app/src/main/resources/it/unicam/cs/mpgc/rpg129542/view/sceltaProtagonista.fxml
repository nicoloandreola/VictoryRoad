<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="720.0" prefWidth="960.0" spacing="28.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg129542.view.ControllerSceltaProtagonista">

    <padding>
        <Insets bottom="40.0" left="45.0" right="45.0" top="40.0" />
    </padding>

    <Label text="SCEGLI IL PROTAGONISTA">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Label>
   <VBox alignment="CENTER" spacing="5.0">
      <children>
      
          <Label text="Seleziona il protagonista con cui iniziare la tua avventura!">
              <font>
                  <Font size="18.0" />
              </font>
          </Label>
         <Label text="(ogni protagonista ha caratteristiche uniche: scegli quello più adatto al tuo stile)" wrapText="true" />
      </children>
   </VBox>

    <HBox alignment="CENTER" spacing="25.0">

        <VBox fx:id="cardProtagonista1" alignment="TOP_CENTER" prefHeight="410.0" prefWidth="250.0" spacing="14.0" styleClass="card-protagonista">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>

            <HBox alignment="CENTER" spacing="10.0">
                <Label fx:id="nomeProtagonista1" text="Personaggio 1">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <StackPane prefHeight="48.0" prefWidth="48.0">
                    <Circle fill="#cc5500" radius="22.0" />
                    <Label fx:id="overallProtagonista1" text="-">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                </StackPane>
            </HBox>

            <Label fx:id="attaccoProtagonista1" text="Attacco: -">
            <font>
               <Font size="14.0" />
            </font></Label>
            <Label fx:id="difesaProtagonista1" text="Difesa: -">
            <font>
               <Font size="14.0" />
            </font></Label>
            <Label fx:id="agilitaProtagonista1" text="Agilità: -">
            <font>
               <Font size="14.0" />
            </font></Label>

            <Region prefHeight="8.0" />

            <Label fx:id="tecnicaProtagonista1" text="Tecnica iniziale: -">
            <font>
               <Font size="14.0" />
            </font></Label>

            <Region VBox.vgrow="ALWAYS" />

            <ImageView fitHeight="125.0" fitWidth="125.0" preserveRatio="true" />

            <Button mnemonicParsing="false" onAction="#scegliProtagonista1" prefHeight="38.0" prefWidth="150.0" text="SCEGLI" />
        </VBox>

        <VBox fx:id="cardProtagonista2" alignment="TOP_CENTER" prefHeight="410.0" prefWidth="250.0" spacing="14.0" styleClass="card-protagonista">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>

            <HBox alignment="CENTER" spacing="10.0">
                <Label fx:id="nomeProtagonista2" text="Personaggio 2">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <StackPane prefHeight="48.0" prefWidth="48.0">
                    <Circle fill="#cc5500" radius="22.0" />
                    <Label fx:id="overallProtagonista2" text="-">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                </StackPane>
            </HBox>

            <Label fx:id="attaccoProtagonista2" text="Attacco: -">
            <font>
               <Font size="14.0" />
            </font></Label>
            <Label fx:id="difesaProtagonista2" text="Difesa: -">
            <font>
               <Font size="14.0" />
            </font></Label>
            <Label fx:id="agilitaProtagonista2" text="Agilità: -">
            <font>
               <Font size="14.0" />
            </font></Label>

            <Region prefHeight="8.0" />

            <Label fx:id="tecnicaProtagonista2" text="Tecnica iniziale: -">
            <font>
               <Font size="14.0" />
            </font></Label>

            <Region VBox.vgrow="ALWAYS" />

            <ImageView fitHeight="125.0" fitWidth="125.0" preserveRatio="true" />

            <Button mnemonicParsing="false" onAction="#scegliProtagonista2" prefHeight="38.0" prefWidth="150.0" text="SCEGLI" />
        </VBox>

        <VBox fx:id="cardProtagonista3" alignment="TOP_CENTER" prefHeight="410.0" prefWidth="250.0" spacing="14.0" styleClass="card-protagonista">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>

            <HBox alignment="CENTER" spacing="10.0">
                <Label fx:id="nomeProtagonista3" text="Personaggio 3">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <StackPane prefHeight="48.0" prefWidth="48.0">
                    <Circle fill="#cc5500" radius="22.0" />
                    <Label fx:id="overallProtagonista3" text="-">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                </StackPane>
            </HBox>

            <Label fx:id="attaccoProtagonista3" text="Attacco: -">
            <font>
               <Font size="14.0" />
            </font></Label>
            <Label fx:id="difesaProtagonista3" text="Difesa: -">
            <font>
               <Font size="14.0" />
            </font></Label>
            <Label fx:id="agilitaProtagonista3" text="Agilità: -">
            <font>
               <Font size="14.0" />
            </font></Label>

            <Region prefHeight="8.0" />

            <Label fx:id="tecnicaProtagonista3" text="Tecnica iniziale: -">
            <font>
               <Font size="14.0" />
            </font></Label>

            <Region VBox.vgrow="ALWAYS" />

            <ImageView fitHeight="125.0" fitWidth="125.0" preserveRatio="true" />

            <Button mnemonicParsing="false" onAction="#scegliProtagonista3" prefHeight="38.0" prefWidth="150.0" text="SCEGLI" />
        </VBox>

    </HBox>
   <HBox alignment="CENTER" spacing="40.0">
      <children>
         <Button mnemonicParsing="false" onAction="#tornaAlMenu" prefHeight="45.0" prefWidth="220.0" text="INDIETRO" />
      
          <Button fx:id="conferma" mnemonicParsing="false" onAction="#confermaScelta" prefHeight="45.0" prefWidth="220.0" text="CONFERMA" />
      </children>
   </HBox>

</VBox>
